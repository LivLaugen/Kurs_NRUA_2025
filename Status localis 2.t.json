      "en" : {
        "at0000.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0000.1",
          "text" : "Status localis",
          "description" : "Findings observed during the physical examination of a body system or anatomical structure."
        }
      },
      "nb" : {
        "at0000.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0000.1",
          "text" : "Status localis",
          "description" : "Funn ved fysisk undersøkelse av et organsystem eller anatomisk struktur.",
          "comment" : "Designkommentar:\nStatus localis: Det brukes særlig om funn fra den fysiske undersøkelsen, og beskriver hva legen faktisk observerer, palperer eller påviser i det aktuelle området.\nEksempler:\n- Ved brystkreft: størrelse, lokalisasjon og palpatoriske funn ved tumor, hudforandringer, lymfeknuter osv.\n- Ved hode-/halskreft: inspeksjons- og palpasjonsfunn i munnhule, svelg, hals og lymfeknutestasjoner.\n- Ved hudforandring: lokalisasjon, størrelse, farge, avgrensning, overflate osv."
        },
        "at0001.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0001.1",
          "text" : "Status localis",
          "description" : "Identifisering av det undersøkte organsystemet eller den anatomiske strukturen.",
          "comment" : "Det anbefales å kode organsystem eller den anatomiske strukturen med en terminologi dersom mulig."
        }
      },
      "pt-br" : {
        "at0000.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0000.1",
          "text" : "Status localis",
          "description" : "Constatações observadas durante o exame físico de um sistema corporal ou estrutura anatômica."
        }
      },
      "de" : {
        "at0000.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0000.1",
          "text" : "Status localis",
          "description" : "Während der körperlichen Untersuchung eines Körpersystems oder einer anatomischen Struktur beobachtete Befunde."
        },
        "at0012.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0012",
          "text" : "Körperstelle",
          "description" : "*Identification of the area of the body under examination. (en)",
          "comment" : "*For example examination of a specific area of skin. If the body site has been fully identified in the 'System or structure examined' data element, this data element becomes redundant. (en)"
        }
      },
      "sv" : {
        "at0000.1" : {
          "@type" : "ARCHETYPE_TERM",
          "code" : "at0000.1",
          "text" : "Status localis",
          "description" : "Observerade fynd vid fysisk undersökning av system i kroppen, eller av anatomisk struktur"
        }
      },
